# Copy to .env (gitignored) and fill in. Never commit .env.

# NASS QuickStats API key (free: https://quickstats.nass.usda.gov/api).
# Mock mode accepts any non-empty value; real mode needs your real key.
NASS_API_KEY=mock-key

# Mock mode only: a fake Earthdata token the local mock accepts. It enables the
# SRTM path in mock mode and is never sent to real servers.
MOCK_EARTHDATA_TOKEN=mock-token

# Real mode (optional): Earthdata login without ~/.netrc. Either a bearer token
# (generate one at https://urs.earthdata.nasa.gov/profile) or username/password.
# EARTHDATA_TOKEN=
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=
